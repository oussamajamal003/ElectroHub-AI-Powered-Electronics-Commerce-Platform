# Non-secret Compose interpolation only; store the deployed file outside the checkout.
RELEASE_SHA=REPLACE_WITH_REVIEWED_40_CHARACTER_SHA
EXPECTED_PROD_PROJECT_REF=yepfgjehdstlxbpespun
PROD_BACKUP_EVIDENCE_REFERENCE=REPLACE_WITH_REVIEWED_BACKUP_EVIDENCE_REFERENCE
CANONICAL_HOST=REPLACE_WITH_APPROVED_LOWERCASE_FQDN
ELECTROHUB_RUNTIME_ENV_DIR=/etc/electrohub
PROD_TLS_DIRECTORY=/etc/electrohub/tls
PROD_ACME_WEBROOT=/var/lib/electrohub/acme
PROD_AI_MODEL_ARTIFACT_DIRECTORY=/srv/electrohub/ai-models
PROD_AI_RELEVANCE_ARTIFACT_DIRECTORY=/srv/electrohub/ai-relevance
# Root-managed trust pin for the separately approved AI_PRODUCTION_RELEASE.json, not the local candidate manifest.
# Deployment preflight rejects a missing/placeholder digest or any release whose exact bytes differ from this pin.
PROD_AI_RELEASE_MANIFEST_SHA256=REPLACE_WITH_APPROVED_RELEASE_MANIFEST_SHA256
# Root-managed bundle intake limits; incoming archives cannot override these values.
# Confirm release bundle sizes before any separately approved host deployment.
PROD_RELEASE_MAX_SOURCE_ARCHIVE_BYTES=536870912
PROD_RELEASE_MAX_IMAGE_ARCHIVE_BYTES=8589934592
PROD_RELEASE_MAX_SOURCE_MEMBERS=50000
PROD_RELEASE_MAX_SOURCE_FILE_BYTES=268435456
PROD_RELEASE_MAX_SOURCE_EXPANDED_BYTES=2147483648
# Set bind addresses only after origin, hostname, TLS and public-exposure approvals are complete.
PROD_HTTP_BIND_ADDRESS=
PROD_HTTPS_BIND_ADDRESS=

# Required after host-specific profiling; no default is provided because the 1 GiB candidate is unmeasured.
API_MEMORY_LIMIT=
API_CPU_LIMIT=
AI_MEMORY_LIMIT=
AI_CPU_LIMIT=
EDGE_MEMORY_LIMIT=
EDGE_CPU_LIMIT=
PAYMENT_WORKER_MEMORY_LIMIT=
PAYMENT_WORKER_CPU_LIMIT=
EMAIL_WORKER_MEMORY_LIMIT=
EMAIL_WORKER_CPU_LIMIT=
MEDIA_WORKER_MEMORY_LIMIT=
MEDIA_WORKER_CPU_LIMIT=
