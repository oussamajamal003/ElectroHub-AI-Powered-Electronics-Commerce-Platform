# Copy to /etc/electrohub/tls.env and set values only after separate operator approvals.
CANONICAL_HOST=REPLACE_WITH_APPROVED_LOWERCASE_FQDN
ACME_CONTACT_EMAIL=REPLACE_WITH_MONITORED_OPERATIONS_EMAIL
ELECTROHUB_RELEASE_ROOT=/var/lib/electrohub
PROD_TLS_DIRECTORY=/etc/electrohub/tls
PROD_ACME_WEBROOT=/var/lib/electrohub/acme
COMPOSE_ENV_FILE=/var/lib/electrohub/current/production.compose.env
COMPOSE_FILE=/var/lib/electrohub/current/source/infrastructure/production/compose.yaml
ACME_STAGING_ONLY=false
TLS_RENEWAL_ENABLED=false
TLS_EXPIRY_WARNING_SECONDS=259200
TLS_ROOT=/etc/electrohub/tls
