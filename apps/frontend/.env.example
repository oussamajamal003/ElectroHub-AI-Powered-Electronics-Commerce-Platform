# ==================================
# ElectroHub Frontend — Environment
# ==================================
# Copy this file to .env and fill in actual values.
# NEVER commit the .env file to Git.
#
# Only variables prefixed with VITE_ are exposed to the client.

# API Base URL
VITE_API_URL=http://localhost:5000/api

VITE_STRIPE_PUBLISHABLE_KEY=

# Discovery Console image search. Leave false until the Task 04.2 Express endpoint
# (POST /api/search/image) is deployed; the console then shows an honest "unavailable" state.
VITE_IMAGE_SEARCH_ENABLED=false

# Task 04.6 delivery map tiles (raster XYZ). Both unset = text-only location panel. Dev/review may use the public OSM tiles within the
# OSMF Tile Usage Policy (low volume, attribution visible); production needs decision D1 (self-hosted or commercial provider) and the
# tile host added to the Nginx CSP img-src.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=© OpenStreetMap contributors
