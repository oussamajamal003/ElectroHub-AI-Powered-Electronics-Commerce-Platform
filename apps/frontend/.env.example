# ==================================
# ElectroHub Frontend — Environment
# ==================================
# Copy this file to .env.local for local development and fill in actual values.
# Render static-site build-time values are public and must be configured in the service build environment.
# NEVER commit .env or .env.local to Git.
#
# Only variables prefixed with VITE_ are exposed to the client.

# The current API and Socket.IO clients use same-origin paths; Vite's development proxy handles local requests.
# VITE_API_URL is not consumed by frontend runtime code. Leave it unset until the separate-origin session gate is approved and tested.
# VITE_API_URL=

VITE_STRIPE_PUBLISHABLE_KEY=

# Discovery Console image search. Leave false until the Task 04.2 Express endpoint
# (POST /api/search/image) is deployed; the console then shows an honest "unavailable" state.
VITE_IMAGE_SEARCH_ENABLED=false

# Task 04.6 delivery map tiles (raster XYZ). Both unset = text-only location panel. Dev/review may use the public OSM tiles within the
# OSMF Tile Usage Policy (low volume, attribution visible); production needs decision D1 (self-hosted or commercial provider) and the
# tile host added to the Nginx CSP img-src.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=© OpenStreetMap contributors
# Optional https link for the attribution (defaults to https://www.openstreetmap.org/copyright).
# VITE_MAP_ATTRIBUTION_URL=
