# Public Vite build inputs only. Every VITE_* value is embedded in browser-delivered assets.
# Set exact approved HTTPS origins. These values contain no secrets.

VITE_API_BASE_URL=https://REPLACE_WITH_RENDER_API_HOSTNAME
VITE_SOCKET_URL=https://REPLACE_WITH_RENDER_API_HOSTNAME
VITE_IMAGE_SEARCH_ENABLED=false
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
