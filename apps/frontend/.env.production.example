# Public Vite build inputs only. Every VITE_* value is embedded in browser-delivered assets.
# This template intentionally has no API origin: api.ts, OAuth popup routes and deliverySocket.ts
# currently require same-origin routing, and the split-origin session gate is BLOCKED pending real browser evidence.
# Do not publish this build until the approved topology and exact public origins are verified.

VITE_IMAGE_SEARCH_ENABLED=false
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=

# VITE_API_URL is currently unused by frontend runtime code. Do not set it as a workaround.
