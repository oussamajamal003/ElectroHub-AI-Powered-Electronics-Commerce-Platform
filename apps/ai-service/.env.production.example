# FastAPI API process only. Do not place commerce, Stripe, Brevo, JWT, migration, ingestion, or media-worker secrets here.
AI_ENVIRONMENT=production
AI_PROCESS_ROLE=api
AI_BIND_HOST=0.0.0.0
AI_PORT=8000
AI_DOCS_ENABLED=false
AI_LOG_LEVEL=INFO
AI_SERVICE_API_KEY=REPLACE_WITH_PER_ENVIRONMENT_RANDOM_KEY

# Production release artifacts are downloaded at startup from private versioned Supabase Storage.
# Never place secrets or signed URLs in Git or render.yaml.
AI_ARTIFACT_DOWNLOAD_URL=REPLACE_WITH_PRIVATE_SIGNED_SUPABASE_STORAGE_URL
AI_ARTIFACT_RELEASE_ID=REPLACE_WITH_APPROVED_RELEASE_ID
AI_PRODUCTION_RELEASE_SHA256=REPLACE_WITH_64_HEX_APPROVED_RELEASE_MANIFEST_SHA256
AI_ARTIFACT_ARCHIVE_SHA256=REPLACE_WITH_64_HEX_ARTIFACT_ARCHIVE_SHA256
AI_ARTIFACT_CACHE_DIR=/tmp/electrohub-ai-artifacts
AI_ARTIFACT_MAX_DOWNLOAD_BYTES=629145600
AI_ARTIFACT_MAX_EXTRACTED_BYTES=943718400
AI_ARTIFACT_DOWNLOAD_TIMEOUT_SECONDS=60
AI_ARTIFACT_DOWNLOAD_RETRIES=3

# Mounted read-only artifacts remain valid for existing Compose deployments. Leave unset for Render download mode.
AI_MODEL_ARTIFACT_DIR=
AI_RELEVANCE_ARTIFACT_DIR=
AI_VECTOR_DATABASE_URL=postgresql://ai_vector_reader:REPLACE_WITH_SECRET@REPLACE_WITH_PROD_SUPABASE_ENDPOINT:5432/postgres?sslmode=verify-full
AI_RECOMMENDATIONS_ENABLED=true

# Tune only from measured capacity and existing bounded model/runtime behavior.
AI_MAX_REQUEST_BYTES=1048576
AI_MAX_IMAGE_BYTES=8388608
AI_MAX_IMAGE_PIXELS=40000000
AI_INFERENCE_TIMEOUT_SECONDS=5
AI_MAX_CONCURRENT_INFERENCES=1
AI_TORCH_THREADS=1
