# ==================================
# ElectroHub AI Service — Environment
# ==================================
# Copy to .env (git-ignored) and fill in values. Placeholders only; never commit secrets.
# The service refuses to start if commerce credentials (Stripe, Brevo, JWT, OTP, Google,
# DATABASE_URL/DIRECT_URL, Supabase service role) are present in its environment.

# development | qa | production | test  (legacy name ENVIRONMENT is still accepted)
AI_ENVIRONMENT="development"
# api (default) | media_worker. Keep worker credentials out of the API process.
AI_PROCESS_ROLE="api"

# Per-environment service credential shared ONLY with that environment's Express backend
# (AI_SERVICE_API_KEY there). >= 32 random printable ASCII chars, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Without it, every /internal/* route answers 503 AI_AUTH_NOT_CONFIGURED; production refuses to start.
AI_SERVICE_API_KEY=""

# Loopback by default. A non-loopback bind requires AI_SERVICE_API_KEY.
AI_BIND_HOST="127.0.0.1"
# MAIN DEV 8000; isolated QA uses its own instance (e.g. 8200) with a different key.
AI_PORT=8000

# Interactive /docs and /openapi.json: default on for development/test, off otherwise, forbidden in production.
# AI_DOCS_ENABLED=false
AI_LOG_LEVEL="INFO"

# Request/resource budgets (defaults shown).
# AI_MAX_REQUEST_BYTES=1048576
# AI_MAX_TOP_K=24
# AI_MAX_CANDIDATES=200
# AI_INFERENCE_TIMEOUT_SECONDS=5
# AI_MAX_CONCURRENT_INFERENCES=2

# Image search (Task 04.2). Names and defaults only; values belong in the deployment secret store.
# Directory with model.safetensors and descriptor.json, mounted READ-ONLY. Unset = image search answers 503.
# AI_MODEL_ARTIFACT_DIR=
# Directory with relevance.json and head.safetensors (calibrated no-match gate, Task 04.2-Q), mounted READ-ONLY.
# Built by training/export_relevance_head.py. Unset = searches always return the nearest topK products.
# AI_RELEVANCE_ARTIFACT_DIR=
# Maximum uploaded image bytes (the multipart route allows this plus 64 KiB of framing).
# AI_MAX_IMAGE_BYTES=8388608
# Maximum decoded pixels per image (side limits 32..12000 are fixed).
# AI_MAX_IMAGE_PIXELS=40000000
# CPU threads for torch inference.
# AI_TORCH_THREADS=2
# Read-only connection to the ai schema (role ai_vector_reader). Must use sslmode=require, verify-ca or verify-full
# for any non-loopback host. Unset = search answers 503.
# AI_VECTOR_DATABASE_URL=

# Task 04.3 — configure only in the separate media-worker process/container, never the online API.
# AI_PROCESS_ROLE=media_worker
# Runtime login ai_media_worker_runtime inherits restricted role ai_media_worker: outbox lease columns + narrow source view + guarded overlay publisher only.
# AI_MEDIA_WORKER_DATABASE_URL=
# Public Supabase project origin (approved DEV/PROD host, or local HTTP loopback in disposable QA).
# The worker constructs immutable object URLs from database-owned bucket/path fields.
# It never accepts arbitrary URLs from the outbox. Required only for SUPABASE_STORAGE media.
# AI_MEDIA_STORAGE_BASE_URL=https://pzxekjybdiulzmssalfo.supabase.co
# Optional local root for read-only legacy /images/... sources during controlled refresh.
# AI_MEDIA_LEGACY_CATALOG_ROOT=apps/frontend/public
