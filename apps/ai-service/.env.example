# ==================================
# ElectroHub AI Service — Environment
# ==================================
# Copy to .env (git-ignored) and fill in values. Placeholders only; never commit secrets.
# The service refuses to start if commerce credentials (Stripe, Brevo, JWT, OTP, Google,
# Cloudinary, DATABASE_URL/DIRECT_URL, Supabase service role) are present in its environment.

# development | qa | production | test  (legacy name ENVIRONMENT is still accepted)
AI_ENVIRONMENT="development"

# Per-environment service credential shared ONLY with that environment's Express backend
# (AI_SERVICE_API_KEY there). >= 32 random printable ASCII chars, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Without it, every /internal/* route answers 503 AI_AUTH_NOT_CONFIGURED; production refuses to start.
AI_SERVICE_API_KEY=""

# Loopback by default. A non-loopback bind requires AI_SERVICE_API_KEY.
AI_BIND_HOST="127.0.0.1"
# MAIN DEV 8000; isolated QA uses its own instance (e.g. 8200) with a different key.
AI_PORT=8000

# Interactive /docs and /openapi.json: default on for development/test, off otherwise, forbidden in production.
# AI_DOCS_ENABLED=false
AI_LOG_LEVEL="INFO"

# Request/resource budgets (defaults shown).
# AI_MAX_REQUEST_BYTES=1048576
# AI_MAX_TOP_K=24
# AI_MAX_CANDIDATES=200
# AI_INFERENCE_TIMEOUT_SECONDS=5
# AI_MAX_CONCURRENT_INFERENCES=2
