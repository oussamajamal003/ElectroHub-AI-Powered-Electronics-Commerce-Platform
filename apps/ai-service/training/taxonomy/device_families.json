  {"family": "computer-mouse", "category": ["gaming", "keyboards-mice", "accessories"], "match": "Cestus|M720|MX Master|MX Anywhere|M650|Lift|Mouse", "prompts": ["a computer mouse", "a wireless mouse on a desk"]},
  {"family": "computer-keyboard", "category": ["keyboards-mice", "accessories"], "match": "K120|K480|K780|MX Keys|Mechanical|Keyboard", "prompts": ["a computer keyboard", "a wireless keyboard"]},
  {"family": "mirrorless-camera", "category": "cameras-photography", "prompts": ["a mirrorless digital camera with a lens", "an interchangeable-lens camera"]},
