  {"family": "document-scanner", "category": "printers-scanners", "match": "ADS", "prompts": ["a desktop document scanner"]},
  {"family": "security-camera", "category": "smart-home", "match": "Tapo C", "prompts": ["a home security camera", "an indoor Wi-Fi camera"]},
  {"family": "smart-bulb", "category": "smart-home", "match": "Tapo L", "prompts": ["a smart light bulb"]},
  {"family": "smart-plug", "category": "smart-home", "match": "Tapo P", "prompts": ["a smart plug"]},
  {"family": "contact-sensor", "category": "smart-home", "match": "Tapo T", "prompts": ["a door or window contact sensor"]},
  {"family": "smartwatch", "category": "smartwatches", "prompts": ["a smartwatch", "a smartwatch on a wrist"]},
  {"family": "internal-ssd", "category": "storage-ssds", "match": "^(?!.*\\bT[0-9]).*$", "prompts": ["an internal solid state drive", "an M.2 NVMe SSD"]},
  {"family": "portable-ssd", "category": "storage-ssds", "match": "\\bT[0-9]", "prompts": ["a portable external SSD"]}
