{
 "version": "families-v1",
 "notes": "Supported families describe kinds of device the catalog sells; each product is assigned to one by category plus an optional name/spec pattern (family_coverage.py checks every catalog product against this file). Unsupported families are visually similar kinds of device the catalog does not sell, used only as competing text evidence; they are not a list of banned products. Prompts are plain descriptions, never product names or photo-specific text.",
 "supported": [
  {"family": "smartphone", "category": "smartphones", "prompts": ["a smartphone", "a mobile phone with a touchscreen", "the back of a smartphone with cameras"]},
