  {"family": "usb-wifi-adapter", "category": "networking-wifi", "match": "USB Wi-Fi adapter", "prompts": ["a USB Wi-Fi adapter"]},
  {"family": "ethernet-switch", "category": "networking-wifi", "match": "Ethernet switch", "prompts": ["a network switch with Ethernet ports"]},
  {"family": "portable-speaker", "category": "speakers-audio", "match": "^(?!.*Bar).*$", "prompts": ["a portable Bluetooth speaker", "a wireless party speaker"]},
  {"family": "soundbar", "category": "speakers-audio", "match": "Bar", "prompts": ["a soundbar under a television"]},
