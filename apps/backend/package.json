{
  "name": "@electrohub/backend",
  "version": "0.1.0",
  "private": true,
  "description": "ElectroHub Backend API — Node.js + Express + TypeScript",
  "main": "dist/server.js",
  "scripts": {
    "prisma:generate": "prisma generate",
    "env:show": "node scripts/env-redacted.cjs",
    "predev": "node scripts/ensure-prisma-client.cjs",
    "dev": "tsx watch src/bootstrap.ts",
    "build": "tsc",
    "start": "node dist/bootstrap.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:logging": "node scripts/logging-safe-tests.cjs",
    "payment:worker": "tsx src/bootstrap.ts --payment-worker",
    "email:worker": "tsx src/bootstrap.ts --commerce-email-worker",
    "email:pg": "node scripts/commerce-email-pg.cjs",
    "payment:dev:preflight": "node scripts/dev-payment-runtime.cjs --preflight",
    "payment:dev": "node scripts/dev-payment-runtime.cjs --start --allow-dev-recovery",
    "dev:isolated": "node scripts/dev-isolated.cjs backend",
    "dev:isolated:real-email": "node scripts/dev-isolated.cjs backend --real-email",
    "dev:isolated:all-recipients": "node scripts/dev-isolated.cjs backend --real-email --all-recipients",
    "db:isolated:emails": "node scripts/dev-isolated.cjs captured",
    "db:isolated:init": "node scripts/dev-isolated.cjs init",
    "db:isolated:start": "node scripts/dev-isolated.cjs start-db",
    "db:isolated:stop": "node scripts/dev-isolated.cjs stop-db",
    "db:isolated:status": "node scripts/dev-isolated.cjs status",
    "test:ci": "vitest run --exclude 'tests/adminSeedLogin.test.ts' --exclude 'tests/auth.integration.test.ts'",
    "lint": "eslint src/ --ext .ts",
    "typecheck": "tsc --noEmit",
    "db:seed": "npx prisma db seed",
    "catalog:expansion": "tsx scripts/catalog-expansion.ts",
    "catalog:expansion:finalize-media": "tsx scripts/catalog-expansion-finalize-media.ts",
    "catalog:expansion:api": "tsx scripts/catalog-expansion-api-smoke.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.12.0",
    "@prisma/client": "^6.12.0",
    "bcrypt": "^6.0.0",
    "bidi-js": "1.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "fontkit": "2.0.4",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "pdfkit": "0.20.2",
    "pg": "^8.23.0",
    "proper-lockfile": "4.1.2",
    "stripe": "^23.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.0",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.7",
    "eslint": "^9.16.0",
    "pdfjs-dist": "4.10.38",
    "prisma": "^6.12.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^4.1.11",
    "winston-transport": "^4.9.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
