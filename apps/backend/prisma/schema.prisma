// Prisma Schema — ElectroHub Backend
// TASK 02.2 — Database Foundation
// Authoritative schema: 14 tables, 8 enums

generator client {
  provider        = "prisma-client-js"
  // relationJoins makes relationLoadStrategy "join" the default (one SQL round trip per
  // relation read). Rollback: remove "relationJoins", run `prisma generate`, and drop any
  // explicit relationLoadStrategy arguments (they require this preview feature to typecheck).
  previewFeatures = ["driverAdapters", "relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  ADMIN
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum InventoryStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum OrderStatus {
  AWAITING_CAPTURE
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
}

enum CheckoutDeliveryMethod {
  STANDARD
  EXPRESS
  OVERNIGHT
}

enum CheckoutPaymentMethod {
  CARD
}

enum DeliveryStatus {
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
}

// Task 04.5 delivery tracking. Order.status stays canonical; these describe the revisioned delivery history.
enum DeliveryEventType {
  TRACKING_STARTED
  STATUS_CHANGED
  LOCATION_UPDATED
  LOCATION_CLEARED
  ETA_UPDATED
  ETA_CLEARED
  SIMULATION_STARTED
  SIMULATION_STOPPED
}

enum DeliveryEventSource {
  ADMIN
  SIMULATION
  SYSTEM
}

enum DeliveryEventChange {
  STATUS
  LOCATION
  ETA
}

enum DeliveryLocationSource {
  MANUAL
  SIMULATED
}

enum AddressType {
  SHIPPING
  BILLING
}

// ─── Models ──────────────────────────────────────────────

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        UserRole @unique
  description String?

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  roleId          String    @db.Uuid
  email           String    @unique @db.VarChar(255)
  pendingEmail    String?   @unique @db.VarChar(255)
  passwordHash    String?   @db.VarChar(255)
  firstName       String    @db.VarChar(100)
  lastName        String    @db.VarChar(100)
  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?

  role                          Role                         @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  addresses                     Address[]
  cart                          Cart?
  wishlist                      Wishlist?
  orders                        Order[]
  refreshTokens                 RefreshToken[]
  passwordResetToken            PasswordResetToken?
  otpChallenges                 OtpChallenge[]
  emailDeliveries               EmailDelivery[]
  securityEvents                SecurityEvent[]
  oauthAccounts                 OAuthAccount[]
  reviews                       Review[]
  paymentAttempts               PaymentAttempt[]
  commerceEmails                CommerceEmailOutbox[]
  deliveryEvents                DeliveryEvent[]              @relation("DeliveryEventActor")
  recommendationPreference      RecommendationPreference?
  productInteractions           ProductInteraction[]
  recentlyViewedProducts        RecentlyViewedProduct[]
  adminSecurity                 AdminAccountSecurity?
  adminMfaFactors               AdminMfaFactor[]
  adminRecoveryCodes            AdminRecoveryCode[]
  adminWebAuthnCredentials      AdminWebAuthnCredential[]
  adminAuthChallenges           AdminAuthChallenge[]
  adminSessions                 AdminSession[]
  adminEmailChangeAuthorization AdminEmailChangeAuthorization?
  adminInvitationsSent          AdminInvitation[]            @relation("AdminInvitationInviter")
  adminInvitationAccepted       AdminInvitation?             @relation("AdminInvitationAcceptedUser")
  adminMfaActivations           AdminMfaActivation[]         @relation("AdminMfaActivationTarget")
  adminMfaActivationsAuthorized AdminMfaActivation[]         @relation("AdminMfaActivationAuthorizer")
  adminSeedIdentity             AdminSeedIdentity?
  adminNotificationPreference   AdminNotificationPreference?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@index([isActive])
  @@map("users")
}

enum OAuthProvider {
  GOOGLE
}

model OAuthAccount {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @db.Uuid
  provider          OAuthProvider
  providerAccountId String        @db.VarChar(255)
  providerEmail     String        @db.VarChar(255)
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([provider, providerEmail])
  @@map("oauth_accounts")
}

model Address {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String      @db.Uuid
  type       AddressType @default(SHIPPING)
  label      String?     @db.VarChar(50)
  recipient  String      @db.VarChar(200)
  line1      String      @db.VarChar(255)
  line2      String?     @db.VarChar(255)
  city       String      @db.VarChar(100)
  state      String?     @db.VarChar(100)
  postalCode String?     @db.VarChar(20)
  country    String      @db.VarChar(100)
  latitude   Decimal?    @db.Decimal(9, 6)
  longitude  Decimal?    @db.Decimal(9, 6)
  isDefault  Boolean     @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, type])
  @@map("addresses")
}

model Category {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @db.VarChar(100)
  slug        String  @unique @db.VarChar(120)
  description String?
  imageUrl    String? @db.VarChar(2048)
  isActive    Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("categories")
}

model Product {
  id                String        @id @default(uuid()) @db.Uuid
  categoryId        String        @db.Uuid
  brandId           String?       @db.Uuid
  sku               String        @unique @db.VarChar(100)
  name              String        @db.VarChar(255)
  slug              String        @unique @db.VarChar(280)
  description       String?
  modelNumber       String?       @db.VarChar(100)
  price             Decimal       @db.Decimal(12, 2)
  compareAtPrice    Decimal?      @db.Decimal(12, 2)
  status            ProductStatus @default(ACTIVE)
  isTestFixture     Boolean       @default(false)
  storefrontVisible Boolean       @default(true)

  category             Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  brand                Brand?                  @relation(fields: [brandId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  images               ProductImage[]
  specifications       ProductSpecification[]
  inventory            Inventory?
  stockAlertEvents     StockAlertEvent[]
  cartItems            CartItem[]
  wishItems            WishlistItem[]
  orderItems           OrderItem[]
  paymentAttemptItems  PaymentAttemptItem[]
  reviews              Review[]
  interactions         ProductInteraction[]
  recentlyViewedBy     RecentlyViewedProduct[]
  recommendationEvents RecommendationEvent[]
  featuredPins         FeaturedProductPin[]
  analyticsEvents      AnalyticsEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([categoryId, status])
  @@index([createdAt])
  @@index([price, createdAt(sort: Desc), id])
  @@map("products")
}

model ProductImage {
  id              String              @id @default(uuid()) @db.Uuid
  productId       String              @db.Uuid
  url             String              @db.VarChar(2048)
  publicId        String?             @db.VarChar(255)
  altText         String?             @db.VarChar(255)
  sortOrder       Int                 @default(0) @map("position")
  isPrimary       Boolean             @default(false)
  storageProvider String              @default("LEGACY_LOCAL") @db.VarChar(32)
  storageBucket   String?             @db.VarChar(100)
  storagePath     String?             @unique @db.VarChar(512)
  sourceRevision  String?             @db.Uuid
  sourceSha256    String?             @db.Char(64)
  sourceMimeType  String?             @db.VarChar(64)
  width           Int?
  height          Int?
  byteSize        Int?
  mediaState      String              @default("PUBLISHED") @db.VarChar(16)
  retiredAt       DateTime?
  mediaEvents     CatalogMediaEvent[]

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([productId, sortOrder], map: "product_images_productId_position_idx")
  @@map("product_images")
}

// Durable media synchronization journal. Image rows are retained as tombstones.
model CatalogMediaEvent {
  id             String       @id @default(uuid()) @db.Uuid
  idempotencyKey String       @unique @db.VarChar(160)
  requestSha256  String       @db.Char(64)
  productId      String       @db.Uuid
  productImageId String       @db.Uuid
  image          ProductImage @relation(fields: [productImageId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "catalog_media_events_image_fkey")
  operation      String       @db.VarChar(24)
  sourceRevision String?      @db.Uuid
  sourceSha256   String?      @db.Char(64)
  state          String       @default("READY") @db.VarChar(24)
  attemptCount   Int          @default(0)
  nextAttemptAt  DateTime     @default(now())
  claimedUntil   DateTime?
  leaseToken     String?      @db.Uuid
  lastErrorCode  String?      @db.VarChar(80)
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([state, nextAttemptAt])
  @@index([productImageId, createdAt])
  @@map("catalog_media_events")
}

model Brand {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(100)
  slug        String    @unique @db.VarChar(120)
  description String?
  logoUrl     String?   @db.VarChar(2048)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("brands")
}

model ProductSpecification {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  group     String   @db.VarChar(100)
  name      String   @db.VarChar(100)
  value     String   @db.VarChar(1000)
  sortOrder Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, group, sortOrder])
  @@map("product_specifications")
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @db.Uuid
  userId    String   @db.Uuid
  rating    Int
  body      String   @db.VarChar(2000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([productId, userId])
  @@index([productId, createdAt, id])
  @@index([userId])
  @@map("reviews")
}

model Inventory {
  id         String          @id @default(uuid()) @db.Uuid
  productId  String          @unique @db.Uuid
  quantity   Int             @default(0)
  lowStockAt Int             @default(5)
  status     InventoryStatus @default(IN_STOCK)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  stockAlertEvents StockAlertEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("inventory")
}

model Cart {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  items           CartItem[]
  paymentAttempts PaymentAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @db.Uuid
  productId String   @db.Uuid
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

model Wishlist {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  items WishlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(uuid()) @db.Uuid
  wishlistId String   @db.Uuid
  productId  String   @db.Uuid
  createdAt  DateTime @default(now())

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([wishlistId, productId])
  @@index([wishlistId])
  @@index([productId])
  @@map("wishlist_items")
}

model Order {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @db.Uuid
  status       OrderStatus @default(CONFIRMED)
  subtotal     Decimal     @db.Decimal(12, 2)
  shippingCost Decimal     @default(0) @db.Decimal(12, 2)
  total        Decimal     @db.Decimal(12, 2)
  currency     String      @default("USD") @db.VarChar(3)
  /// Immutable seller identity captured when the order is created. NULL identifies legacy orders and renders with the historical ElectroHub profile.
  storeIdentitySnapshot Json?

  checkoutAttemptId      String                 @db.Uuid
  checkoutRequestHash    String                 @db.VarChar(64)
  deliveryMethod         CheckoutDeliveryMethod
  paymentMethod          CheckoutPaymentMethod
  shippingPhone          String                 @db.VarChar(32)
  estimatedDeliveryStart DateTime               @db.Date
  estimatedDeliveryEnd   DateTime               @db.Date

  shippingRecipient  String   @db.VarChar(200)
  shippingLine1      String   @db.VarChar(255)
  shippingLine2      String?  @db.VarChar(255)
  shippingCity       String   @db.VarChar(100)
  shippingState      String?  @db.VarChar(100)
  shippingPostalCode String?  @db.VarChar(20)
  shippingCountry    String   @db.VarChar(100)
  shippingLatitude   Decimal? @db.Decimal(9, 6)
  shippingLongitude  Decimal? @db.Decimal(9, 6)

  user           User                  @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items          OrderItem[]
  payment        Payment?
  delivery       Delivery?
  paymentAttempt PaymentAttempt?
  commerceEmails CommerceEmailOutbox[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, checkoutAttemptId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id              String  @id @default(uuid()) @db.Uuid
  orderId         String  @db.Uuid
  productId       String  @db.Uuid
  productName     String  @db.VarChar(255)
  sku             String  @db.VarChar(100)
  productImageUrl String? @db.VarChar(2048)
  unitPrice       Decimal @db.Decimal(12, 2)
  quantity        Int
  lineTotal       Decimal @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id                String          @id @default(uuid()) @db.Uuid
  orderId           String          @unique @db.Uuid
  provider          PaymentProvider @default(STRIPE)
  providerPaymentId String?         @unique @db.VarChar(255)
  status            PaymentStatus   @default(PENDING)
  amount            Decimal         @db.Decimal(12, 2)
  currency          String          @default("USD") @db.VarChar(3)
  paidAt            DateTime?
  failureReason     String?
  cardBrand         String?         @db.VarChar(32)
  cardLast4         String?         @db.VarChar(4)
  refundedAt        DateTime?

  order          Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  commerceEmails CommerceEmailOutbox[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([provider, status])
  @@map("payments")
}

enum PaymentAttemptState {
  PREPARING
  AWAITING_INPUT
  ACTION_REQUIRED
  DECLINED
  PROCESSING
  AUTHORIZED
  CAPTURE_PENDING
  PAID
  CANCEL_PENDING
  CANCELED
  COMPENSATION_PENDING
  COMPENSATED
  REFUND_PENDING
  REFUNDED
  INCIDENT
}

enum PaymentWorkState {
  READY
  LEASED
  DONE
  INCIDENT
}

model PaymentAttempt {
  id                     String               @id @default(uuid()) @db.Uuid
  userId                 String               @db.Uuid
  cartId                 String?              @db.Uuid
  cartIdentity           String               @db.Uuid
  // Nullable unique claim prevents two active purchase attempts for one Cart.
  activeCartId           String?              @unique @db.Uuid
  idempotencyKey         String               @db.Uuid
  requestHash            String               @db.VarChar(64)
  revision               String               @db.VarChar(64)
  request                Json
  subtotal               Decimal              @db.Decimal(12, 2)
  shippingCost           Decimal              @db.Decimal(12, 2)
  total                  Decimal              @db.Decimal(12, 2)
  amountCents            Int
  currency               String               @default("USD") @db.VarChar(3)
  stripeAccountId        String               @db.VarChar(255)
  providerIntentId       String?              @unique @db.VarChar(255)
  providerStatus         String?              @db.VarChar(64)
  state                  PaymentAttemptState  @default(PREPARING)
  cancelRequested        Boolean              @default(false)
  failureCode            String?              @db.VarChar(64)
  authorizationExpiresAt DateTime?
  expiresAt              DateTime
  orderId                String?              @unique @db.Uuid
  refundId               String?              @unique @db.VarChar(255)
  refundAmountCents      Int?
  compensatedAt          DateTime?
  // Only IDs/quantities not merged back into Cart; never a second Product store.
  recoveryRemainder      Json?
  // Durable submission transfers exact cart lines to this immutable purchase.
  submittedAt            DateTime?
  confirmationStartedAt  DateTime?
  restoredAt             DateTime?
  notificationReadState  String?              @db.VarChar(32)
  // Customer-only hide for a failed card. Financial and audit records are never deleted or changed by this flag.
  dismissedAt            DateTime?
  user                   User                 @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cart                   Cart?                @relation(fields: [cartId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  order                  Order?               @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items                  PaymentAttemptItem[]
  work                   PaymentWork?
  events                 StripeEvent[]
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([cartId])
  @@index([state, expiresAt])
  @@map("payment_attempts")
}

model PaymentAttemptItem {
  sourceCartItemId   String?        @unique @db.Uuid
  snapshotCartItemId String?        @db.Uuid
  id                 String         @id @default(uuid()) @db.Uuid
  attemptId          String         @db.Uuid
  productId          String         @db.Uuid
  productName        String         @db.VarChar(255)
  sku                String         @db.VarChar(100)
  imageUrl           String?        @db.VarChar(2048)
  quantity           Int
  unitPrice          Decimal        @db.Decimal(12, 2)
  lineTotal          Decimal        @db.Decimal(12, 2)
  attempt            PaymentAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  product            Product        @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([attemptId, productId])
  @@index([productId])
  @@map("payment_attempt_items")
}

model PaymentWork {
  id         String           @id @default(uuid()) @db.Uuid
  attemptId  String           @unique @db.Uuid
  state      PaymentWorkState @default(READY)
  nextRunAt  DateTime         @default(now())
  retryCount Int              @default(0)
  leaseToken String?          @db.Uuid
  leaseUntil DateTime?
  lastError  String?          @db.VarChar(64)
  attempt    PaymentAttempt   @relation(fields: [attemptId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([state, nextRunAt])
  @@index([state, leaseUntil])
  @@map("payment_work")
}

model StripeEvent {
  id               String          @id @db.VarChar(255)
  type             String          @db.VarChar(100)
  providerIntentId String?         @db.VarChar(255)
  attemptId        String?         @db.Uuid
  disposition      String          @db.VarChar(32)
  attempt          PaymentAttempt? @relation(fields: [attemptId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt        DateTime        @default(now())

  @@index([attemptId])
  @@map("stripe_events")
}

model Delivery {
  id                String                  @id @default(uuid()) @db.Uuid
  orderId           String                  @unique @db.Uuid
  status            DeliveryStatus          @default(CONFIRMED)
  trackingCode      String?                 @unique @db.VarChar(100)
  latitude          Decimal?                @db.Decimal(9, 6)
  longitude         Decimal?                @db.Decimal(9, 6)
  estimatedAt       DateTime?
  deliveredAt       DateTime?
  // Task 04.5: +1 per accepted change (CHECK revision >= 0); each accepted change writes exactly one DeliveryEvent.
  revision          Int                     @default(0)
  locationLabel     String?                 @db.VarChar(80)
  locationSource    DeliveryLocationSource?
  locationUpdatedAt DateTime?
  etaUpdatedAt      DateTime?
  isSimulated       Boolean                 @default(false)

  order  Order           @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  events DeliveryEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([status, updatedAt])
  @@map("deliveries")
}

/// Immutable revisioned delivery history (Task 04.5). Only the account-deletion / retention scrubs null coordinates and notes.
model DeliveryEvent {
  id          String                @id @default(uuid()) @db.Uuid
  deliveryId  String                @db.Uuid
  revision    Int
  type        DeliveryEventType
  changes     DeliveryEventChange[]
  source      DeliveryEventSource
  fromStatus  OrderStatus?
  toStatus    OrderStatus?
  latitude    Decimal?              @db.Decimal(9, 6)
  longitude   Decimal?              @db.Decimal(9, 6)
  estimatedAt DateTime?
  actorUserId String?               @db.Uuid
  note        String?               @db.VarChar(280)
  occurredAt  DateTime              @default(now())
  createdAt   DateTime              @default(now())

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  actor    User?    @relation("DeliveryEventActor", fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([deliveryId, revision])
  @@index([deliveryId, occurredAt])
  @@index([type, occurredAt])
  @@map("delivery_events")
}

model RefreshToken {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @db.Uuid
  tokenHash           String   @unique @db.VarChar(255)
  expiresAt           DateTime
  isRevoked           Boolean  @default(false)
  // Session family: every generation of one login shares this value. The application always sets it
  // explicitly (new family on login, inherited on rotation). There is deliberately NO database default:
  // an old-version instance that omits it fails its INSERT instead of silently minting a disconnected family.
  familyId            String   @db.Uuid
  // Durable successor pointer, written in the same transaction that revokes this token.
  replacedByTokenHash String?  @unique @db.VarChar(255)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId])
  @@index([tokenHash])
  @@index([familyId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @unique @db.Uuid
  tokenHash  String    @unique @db.VarChar(255)
  expiresAt  DateTime
  consumedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([tokenHash])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

enum SecurityEventType {
  EMAIL_VERIFIED
  PASSWORD_CHANGED
  PASSWORD_RESET
  EMAIL_CHANGED
  GOOGLE_CONNECTED
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  ACCOUNT_DELETED
  // Task 05.2 administrator security (append-only facts; never secrets).
  ADMIN_MFA_CHALLENGE_FAILED
  ADMIN_MFA_ENROLLED
  ADMIN_MFA_DISABLED
  ADMIN_RECOVERY_CODES_REGENERATED
  ADMIN_RECOVERY_CODE_USED
