// ─── OTP & Email Foundation (TASK 02.4-A) ─────────────────

enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE
  SENSITIVE_ACTION
}

enum OtpChannel {
  EMAIL
}

enum EmailDeliveryStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  FAILED
  BOUNCED
  BLOCKED
}

enum EmailType {
  ACCOUNT_VERIFICATION
  PASSWORD_RESET
  PASSWORD_CHANGED
  EMAIL_CHANGED
  SECURITY_ALERT
  ADMIN_INVITATION
  ADMIN_NOTIFICATION
  ADMIN_ACTIVATION
  ADMIN_EMAIL_CHANGE_OTP
  ADMIN_EMAIL_CHANGE_OLD
  ADMIN_EMAIL_CHANGE_NEW
}

model OtpChallenge {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @db.Uuid
  purpose     OtpPurpose
  channel     OtpChannel @default(EMAIL)
  destination String     @db.VarChar(255)
  codeHash    String     @db.VarChar(255)
  expiresAt   DateTime
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  resendCount Int        @default(0)
  lastSentAt  DateTime?
  consumedAt  DateTime?
  lockedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  adminEmailChangeAuthorization AdminEmailChangeAuthorization?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, purpose])
  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("otp_challenges")
}

model EmailDelivery {
  id                String              @id @default(uuid()) @db.Uuid
  userId            String?             @db.Uuid
  type              EmailType
  recipient         String              @db.VarChar(255)
  provider          String              @default("BREVO") @db.VarChar(50)
  providerMessageId String?             @unique @db.VarChar(255)
  status            EmailDeliveryStatus @default(QUEUED)
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  failureReason     String?
  attempts          Int                 @default(0)
  nextAttemptAt     DateTime?
  stockAlertEventId String?             @db.Uuid

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  stockAlertEvent StockAlertEvent? @relation(fields: [stockAlertEventId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([type, status])
  @@index([recipient])
  @@index([createdAt])
  @@index([stockAlertEventId, status, nextAttemptAt])
  @@unique([stockAlertEventId, userId])
  @@map("email_deliveries")
}

/// Durable, committed inventory-category transition. The event is an internal outbox record: it is never exposed to browsers,
/// and one optional stock-warning delivery can exist per eligible administrator.
model StockAlertEvent {
  id             String          @id @default(uuid()) @db.Uuid
  productId      String          @db.Uuid
  previousStatus InventoryStatus?
  status         InventoryStatus
  quantity       Int
  lowStockAt     Int
  productName    String          @db.VarChar(255)
  sku            String          @db.VarChar(100)
  processedAt    DateTime?

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "stock_alert_events_productId_fkey")
  inventory      Inventory       @relation(fields: [productId], references: [productId], onDelete: Cascade, onUpdate: Cascade, map: "stock_alert_events_productId_inventory_fkey")
  deliveries     EmailDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([processedAt, createdAt])
  @@index([productId, createdAt])
  @@map("stock_alert_events")
}

// ─── Task 03.8 — Commerce email outbox ───────────────────
// Separate from the auth EmailDelivery ledger: OTP rows have no recoverable payload and must never be
// selected by a retrying worker. Physical CHECKs, guard trigger, RLS and grants live in migration
// 20261018000000_commerce_email_outbox (Prisma cannot express them).

enum CommerceEmailType {
  ORDER_CONFIRMED
  PAYMENT_CONFIRMED
  ORDER_PREPARING
  ORDER_OUT_FOR_DELIVERY
  ORDER_DELIVERED
  ORDER_CANCELLED
  PAYMENT_REFUNDED
}

enum CommerceEmailDispatchState {
  READY
  LEASED
  RETRY_WAIT
  ACCEPTED
  UNCERTAIN
  FAILED
  SUPPRESSED
}

enum CommerceEmailDeliveryState {
  UNKNOWN
  DELIVERED
  BOUNCED
  BLOCKED
}

enum CommerceEmailAttemptOutcome {
  STARTED
  ACCEPTED
  REJECTED
  UNCERTAIN
}

model CommerceEmailOutbox {
  id                String                     @id @default(uuid()) @db.Uuid
  eventKey          String                     @unique @db.VarChar(255)
  type              CommerceEmailType
  orderId           String                     @db.Uuid
  paymentId         String?                    @db.Uuid
  userId            String?                    @db.Uuid
  transitionId      String?                    @db.Uuid
  fromStatus        String?                    @db.VarChar(32)
  toStatus          String?                    @db.VarChar(32)
  recipient         String?                    @db.VarChar(255)
  snapshot          Json?
  snapshotVersion   Int                        @default(1)
  templateVersion   String                     @db.VarChar(16)
  occurredAt        DateTime
  dispatchState     CommerceEmailDispatchState @default(READY)
  deliveryState     CommerceEmailDeliveryState @default(UNKNOWN)
  attemptCount      Int                        @default(0)
  nextAttemptAt     DateTime                   @default(now())
  leaseToken        String?                    @db.Uuid
  leaseUntil        DateTime?
  provider          String                     @default("BREVO") @db.VarChar(16)
  providerMessageId String?                    @unique @db.VarChar(255)
  acceptedAt        DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  uncertainAt       DateTime?
  lastErrorCode     String?                    @db.VarChar(64)
  suppressionReason String?                    @db.VarChar(64)
  payloadPurgedAt   DateTime?

  order    Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  payment  Payment?               @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user     User?                  @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  attempts CommerceEmailAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dispatchState, nextAttemptAt, createdAt])
  @@index([dispatchState, leaseUntil])
  @@index([orderId, createdAt])
  @@index([paymentId])
  @@index([userId])
  @@map("commerce_email_outbox")
}

model CommerceEmailAttempt {
  id                String                      @id @default(uuid()) @db.Uuid
  outboxId          String                      @db.Uuid
  attemptNumber     Int
  leaseToken        String                      @db.Uuid
  startedAt         DateTime
  finishedAt        DateTime?
  outcome           CommerceEmailAttemptOutcome @default(STARTED)
  providerMessageId String?                     @db.VarChar(255)
  httpStatus        Int?
  errorCode         String?                     @db.VarChar(64)

  outbox CommerceEmailOutbox @relation(fields: [outboxId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([outboxId, attemptNumber])
  @@index([outboxId, startedAt])
  @@map("commerce_email_attempts")
}

/// Task 04.4: explicit, opt-in personalization consent. Absent row = personalization off.
model RecommendationPreference {
  userId                 String    @id @db.Uuid
  personalizationEnabled Boolean   @default(false)
  consentedAt            DateTime?
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("recommendation_preferences")
}

/// Task 04.4: signed-in, consenting customers' meaningful product activity (VIEW, RECOMMENDATION_CLICK).
/// Purchases, cart and wishlist signals are read from their authoritative tables, never from client events.
model ProductInteraction {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  productId      String   @db.Uuid
  eventType      String   @db.VarChar(32)
  surface        String   @db.VarChar(32)
  idempotencyKey String   @db.VarChar(100)
  occurredAt     DateTime
  receivedAt     DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, occurredAt])
  @@index([productId, eventType, occurredAt])
  @@index([occurredAt])
  @@map("product_interactions")
}

/// Task 04.4: one row per (customer, product), capped per customer by the service.
model RecentlyViewedProduct {
  userId       String   @db.Uuid
  productId    String   @db.Uuid
  lastViewedAt DateTime
  viewCount    Int      @default(1)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([userId, productId])
  @@index([userId, lastViewedAt])
  @@index([lastViewedAt])
  @@map("recently_viewed_products")
}

/// Task 04.4: non-personal recommendation attribution (no user or session identifier). One row per
/// (server-issued batch, product, event type), so retries and replays cannot inflate counts.
model RecommendationEvent {
  id         String   @id @default(uuid()) @db.Uuid
  batchId    String   @db.Uuid
  productId  String   @db.Uuid
  eventType  String   @db.VarChar(16)
  mode       String   @db.VarChar(32)
  strategy   String   @db.VarChar(32)
  surface    String   @db.VarChar(32)
  rank       Int
  occurredAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([batchId, productId, eventType])
  @@index([productId, eventType, occurredAt])
  @@index([occurredAt])
  @@map("recommendation_events")
}

// ─── Task 05.2 — Administrator security ──────────────────
// Every table below is private to Express (RLS enabled, no PostgREST grants). Secrets are never stored in clear:
// TOTP seeds are AES-256-GCM ciphertext under a versioned key, recovery codes / invitation and challenge tokens are
// keyed digests, and WebAuthn keeps only the COSE public key.

enum AdminInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum AdminInvitationDelivery {
  PENDING
  SENT
  FAILED
}

enum AdminChallengePurpose {
  LOGIN
  STEP_UP
  WEBAUTHN_REGISTRATION
  /// Forgot-password: email OTP proven, existing factor still required. Never convertible into a session.
  PASSWORD_RECOVERY
}

enum AdminMfaMethod {
  TOTP
  WEBAUTHN
  RECOVERY_CODE
}

/// Per-administrator security state and capabilities. Absent row = no capability, no enrollment authorization.
model AdminAccountSecurity {
  userId                 String    @id @db.Uuid
  isOwner                Boolean   @default(false)
  canManageAdmins        Boolean   @default(false)
  /// Operator- or invitation-granted window in which a factor-less administrator may enroll a first factor.
  enrollmentAllowedUntil DateTime?
  mfaEnrolledAt          DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isOwner])
  @@map("admin_account_security")
}

/// TOTP factor. verifiedAt NULL = enrollment in progress (never accepted for sign-in).
model AdminMfaFactor {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  label            String    @db.VarChar(60)
  secretCiphertext String    @db.VarChar(255)
  keyVersion       Int
  lastUsedStep     BigInt?
  verifiedAt       DateTime?
  disabledAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("admin_mfa_factors")
}

model AdminRecoveryCode {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  batchId    String    @db.Uuid
  codeHash   String    @unique @db.VarChar(64)
  consumedAt DateTime?
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, batchId])
  @@map("admin_recovery_codes")
}

model AdminWebAuthnCredential {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  credentialId String    @unique @db.VarChar(512)
  publicKey    Bytes
  counter      BigInt    @default(0)
  transports   String[]  @default([])
  deviceType   String    @db.VarChar(32)
  backedUp     Boolean   @default(false)
  label        String    @db.VarChar(60)
  lastUsedAt   DateTime?
  revokedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("admin_webauthn_credentials")
}

/// Restricted, short-lived, single-use pre-auth / step-up transaction. Never authorizes /api/admin/**.
model AdminAuthChallenge {
  id                    String                @id @default(uuid()) @db.Uuid
  tokenHash             String                @unique @db.VarChar(64)
  userId                String                @db.Uuid
  purpose               AdminChallengePurpose
  /// Session family a STEP_UP / WEBAUTHN_REGISTRATION challenge is bound to.
  sessionFamilyId       String?               @db.Uuid
  /// Digest of the password hash the primary proof was checked against; a password change voids the challenge.
  credentialFingerprint String                @db.VarChar(64)
  webauthnChallenge     String?               @db.VarChar(128)
  attempts              Int                   @default(0)
  maxAttempts           Int                   @default(5)
  expiresAt             DateTime
  consumedAt            DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("admin_auth_challenges")
}

/// One row per MFA-assured administrator session family (RefreshToken.familyId). Authoritative for access AND refresh.
model AdminSession {
  familyId      String         @id @db.Uuid
  userId        String         @db.Uuid
  mfaMethod     AdminMfaMethod
  mfaVerifiedAt DateTime
  stepUpAt      DateTime?
  userAgent     String?        @db.VarChar(300)
  ipAddress     String?        @db.VarChar(64)
  lastSeenAt    DateTime
  revokedAt     DateTime?
  revokedReason String?        @db.VarChar(40)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("admin_sessions")
}

/// Short-lived, single-use proof that an administrator verified their password and recent MFA in one exact live session before
/// confirming possession of a proposed email address. One row per administrator prevents parallel pending changes.
model AdminEmailChangeAuthorization {
  userId                String   @id @db.Uuid
  currentEmail          String   @db.VarChar(255)
  targetEmail           String   @db.VarChar(255)
  sessionFamilyId       String   @db.Uuid
  credentialFingerprint String   @db.VarChar(64)
  securityFingerprint   String   @db.VarChar(64)
  stepUpAt              DateTime
  challengeId           String?  @unique @db.Uuid
  expiresAt             DateTime
  resendAvailableAt     DateTime
  cancelledAt           DateTime?
  consumedAt            DateTime?

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  challenge OtpChallenge? @relation(fields: [challengeId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionFamilyId])
  @@index([expiresAt])
  @@map("admin_email_change_authorizations")
}

model AdminInvitation {
  id                String                  @id @default(uuid()) @db.Uuid
  /// Normalized recipient; one PENDING invitation per email (partial unique index in SQL).
  email             String                  @db.VarChar(255)
  tokenHash         String                  @unique @db.VarChar(64)
  invitedById       String?                 @db.Uuid
  status            AdminInvitationStatus   @default(PENDING)
  deliveryStatus    AdminInvitationDelivery @default(PENDING)
  grantManageAdmins Boolean                 @default(false)
  expiresAt         DateTime
  sendCount         Int                     @default(0)
  lastSentAt        DateTime?
  acceptedUserId    String?                 @unique @db.Uuid
  acceptedAt        DateTime?
  revokedAt         DateTime?

  invitedBy    User? @relation("AdminInvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  acceptedUser User? @relation("AdminInvitationAcceptedUser", fields: [acceptedUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@map("admin_invitations")
}

/// Which trust model a single-use activation proof belongs to. OWNER_ACTIVATION: an Owner authorized it and it was emailed (mailbox
/// possession). SEED_PROVISIONING: an operator authorized it for an approved seed identity and handed it over out of band (no email
/// proof). A proof is redeemable only on its own purpose's endpoint.
enum AdminActivationPurpose {
  OWNER_ACTIVATION
  SEED_PROVISIONING
  SEED_PASSWORD_RECOVERY
}

enum AdminSeedIdentitySource {
  SEED
  OPERATOR
}

/// Approved seed administrator identity, bound to the exact user id (never inferred from the email address).
model AdminSeedIdentity {
  userId     String                  @id @db.Uuid
  seedEmail  String                  @unique @db.VarChar(255)
  source     AdminSeedIdentitySource
  approvedBy String?                 @db.VarChar(120)
  reason     String?                 @db.VarChar(500)
  createdAt  DateTime                @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("admin_seed_identities")
}

enum AdminActivationStatus {
  PENDING
  REDEEMED
  REVOKED
}

/// Owner-authorized, single-use proof that lets an EXISTING factor-less administrator rotate its credential and open first-factor
/// enrollment. One PENDING row per target (partial unique index in SQL). Only the token digest is stored.
model AdminMfaActivation {
  id             String                  @id @default(uuid()) @db.Uuid
  userId         String                  @db.Uuid
  authorizedById String?                 @db.Uuid
  /// Address the link was sent to, bound at issue time; redemption re-checks it against the account.
  email          String                  @db.VarChar(255)
  tokenHash      String                  @unique @db.VarChar(64)
  status         AdminActivationStatus   @default(PENDING)
  deliveryStatus AdminInvitationDelivery @default(PENDING)
  expiresAt      DateTime
  sendCount      Int                     @default(0)
  lastSentAt     DateTime?
  redeemedAt     DateTime?
  revokedAt      DateTime?
  purpose        AdminActivationPurpose  @default(OWNER_ACTIVATION)
  operatorName   String?                 @db.VarChar(120)
  operatorReason String?                 @db.VarChar(500)

  user         User  @relation("AdminMfaActivationTarget", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  authorizedBy User? @relation("AdminMfaActivationAuthorizer", fields: [authorizedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@map("admin_mfa_activations")
}

/// Sanitized, append-only audit of administrative configuration and team changes (no secrets, no request bodies).
model AdminAuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @db.Uuid
  action       String   @db.VarChar(64)
  resourceType String   @db.VarChar(40)
  resourceId   String?  @db.VarChar(100)
  outcome      String   @db.VarChar(16)
  details      Json?
  requestId    String?  @db.VarChar(64)
  createdAt    DateTime @default(now())

  @@index([resourceType, createdAt])
  @@index([actorId, createdAt])
  @@map("admin_audit_logs")
}

// ─── Task 05.2 — Store, shipping and notification settings ─

