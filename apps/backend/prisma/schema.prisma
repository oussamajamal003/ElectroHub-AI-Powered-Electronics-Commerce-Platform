// ─── Task 05.2 — Recommendation management ───────────────

/// Published per-surface, per-mode rail configuration. Absent row = engine default (enabled, default limit).
model RecommendationSectionConfig {
  surface     String  @db.VarChar(32)
  mode        String  @db.VarChar(32)
  enabled     Boolean @default(true)
  itemLimit   Int
  version     Int     @default(1)
  updatedById String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([surface, mode])
  @@map("recommendation_section_configs")
}

/// Explicit merchandising placement, labeled "Featured" to customers; never presented as personalization.
model FeaturedProductPin {
  id          String    @id @default(uuid()) @db.Uuid
  productId   String    @db.Uuid
  surface     String    @db.VarChar(32)
  position    Int
  startsAt    DateTime?
  endsAt      DateTime?
  enabled     Boolean   @default(true)
  version     Int       @default(1)
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([surface, productId])
  @@index([surface, enabled, position])
  @@map("featured_product_pins")
}

// ─── Task 05.2 — Analytics instrumentation ───────────────

/// Server-recorded (or server-signed client) behavioural facts that no existing table holds. Never an uploaded image,
/// never a user identifier; business truth (revenue, orders, payments) is always read from its authoritative table.
model AnalyticsEvent {
  id             String   @id @default(uuid()) @db.Uuid
  type           String   @db.VarChar(48)
  source         String   @db.VarChar(16)
  outcome        String?  @db.VarChar(24)
  correlationId  String?  @db.Uuid
  productId      String?  @db.Uuid
  resultCount    Int?
  durationMs     Int?
  idempotencyKey String   @unique @db.VarChar(100)
  occurredAt     DateTime
  receivedAt     DateTime @default(now())

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([type, occurredAt])
  @@index([occurredAt])
  @@map("analytics_events")
}
