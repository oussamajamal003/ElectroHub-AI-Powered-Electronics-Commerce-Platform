# ==================================
# ElectroHub Backend - Environment
# ==================================

# Application
NODE_ENV=development
PORT=5000

# Frontend URL
FRONTEND_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Development Database
# DATABASE_URL is the default development runtime candidate. Port 6543 is rejected for this persistent/session workload.
# This existing configuration explicitly selects DIRECT_URL (the session pooler on 5432, not direct IPv6).
# Alternatively set DATABASE_URL to a verified session/direct endpoint and DB_RUNTIME_URL_SOURCE=database.
DB_RUNTIME_URL_SOURCE=direct
# Prisma CLI uses DATABASE_URL as datasource URL and DIRECT_URL for migrations.
DATABASE_URL="postgresql://postgres.pzxekjybdiulzmssalfo:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.pzxekjybdiulzmssalfo:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"
# Optional CA certificate file for verifying the database TLS chain.
# DB_SSL_CA_CERT_PATH=C:/path/to/database-ca.pem

# Authentication
# Generate a unique value with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here
OTP_HASH_SECRET=your-otp-hash-secret-here

# AI Service
AI_SERVICE_URL=http://localhost:8000
# Public photo search upstream budget in ms (default 8000, max 15000). Other AI calls keep AI_SERVICE_TIMEOUT_MS.
# AI_IMAGE_SEARCH_TIMEOUT_MS=8000

# Stripe Test Mode
STRIPE_SECRET_KEY=sk_test_your-stripe-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# Brevo
BREVO_API_KEY=your-brevo-api-key-here
BREVO_SENDER_EMAIL=your-verified-email@example.com
BREVO_SENDER_NAME=ElectroHub

# Commerce email (Task 03.8). Safe defaults: nothing is enqueued, dispatched or sent until deliberately enabled.
# COMMERCE_EMAIL_ENQUEUE_ENABLED=false        # producer: create outbox events with Order/Payment transitions
# COMMERCE_EMAIL_DISPATCH_ENABLED=false       # worker master switch (npm run email:worker)
# COMMERCE_EMAIL_SEND_MODE=disabled           # disabled | capture (disposable DB only) | allowlist | live
# COMMERCE_EMAIL_ALLOWED_RECIPIENTS=          # allowlist mode: comma-separated controlled test mailboxes only
# COMMERCE_EMAIL_LIVE_APPROVED_TARGET=        # live mode on a shared DB: exact host:port/database identity
# COMMERCE_EMAIL_ORIGIN=                      # trusted HTTPS frontend origin for email links (falls back to FRONTEND_URL)
# COMMERCE_EMAIL_CAPTURE_DIR=                 # capture mode output directory
# COMMERCE_EMAIL_BATCH_SIZE=10
# COMMERCE_EMAIL_CONCURRENCY=2
# COMMERCE_EMAIL_POLL_MS=5000
# COMMERCE_EMAIL_PROVIDER_TIMEOUT_MS=10000
# COMMERCE_EMAIL_LEASE_MS=60000

# Product-image hosts accepted in commerce emails, in addition to the configured Supabase Storage host and the
# COMMERCE_EMAIL_ORIGIN host. Comma-separated hostnames only; anything else is omitted from the email, never blocks it.
# COMMERCE_EMAIL_IMAGE_HOSTS=

# --- Commerce email, DEV test-mode block (Task 03.8). Copy into the untracked .env.local; restart the launcher after changes. ---
# Shared DEV defaults to dispatch OFF. Explicit --allow-email-allowlist requires reviewed recipients, empty backlog and pool headroom.
# Isolated QA defaults to capture with separate auth secrets; external Stripe/Brevo credentials are not inherited by default.
# `npm run dev:isolated -- --stripe-test-mode` is an explicit controlled Test Mode provider opt-in (never use for autonomous mocks).
# allowlist = only these approved mailboxes can receive real email; everyone else's events stay READY and visible.
# COMMERCE_EMAIL_ENQUEUE_ENABLED=true
# COMMERCE_EMAIL_DISPATCH_ENABLED=true
# COMMERCE_EMAIL_SEND_MODE=allowlist
# COMMERCE_EMAIL_ALLOWED_RECIPIENTS=approved.one@example.com,approved.two@example.com
# COMMERCE_EMAIL_ORIGIN=http://localhost:3000

# Task 04.3 — backend-only, optional until product media is enabled. Never prefix secrets with VITE_.
# Storage project must match the actual database (DEV shown; PROD uses its own project and key).
# SUPABASE_URL=https://pzxekjybdiulzmssalfo.supabase.co
# SUPABASE_PROJECT_REF=pzxekjybdiulzmssalfo
# SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=  # legacy JWT fallback only
# PRODUCT_MEDIA_BUCKET=product-media
# PRODUCT_MEDIA_STORAGE_TIMEOUT_MS=10000  # bounded 100..30000; increase for measured cross-region latency
# COMMERCE_EMAIL_IMAGE_HOSTS=pzxekjybdiulzmssalfo.supabase.co
