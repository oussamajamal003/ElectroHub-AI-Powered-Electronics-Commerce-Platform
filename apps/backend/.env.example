# ==================================
# ElectroHub Backend - Environment
# ==================================

# Application
NODE_ENV=development
PORT=5000

# Frontend URL
FRONTEND_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Development Database
# The API and payment runner currently prefer DIRECT_URL for runtime queries.
# This example DIRECT_URL is the session pooler (5432), not direct IPv6.
# Prisma CLI uses DATABASE_URL as datasource URL and DIRECT_URL for migrations.
DATABASE_URL="postgresql://postgres.pzxekjybdiulzmssalfo:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.pzxekjybdiulzmssalfo:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"
# Optional CA certificate file for verifying the database TLS chain.
# DB_SSL_CA_CERT_PATH=C:/path/to/database-ca.pem

# Authentication
# Generate a unique value with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here
OTP_HASH_SECRET=your-otp-hash-secret-here

# AI Service
AI_SERVICE_URL=http://localhost:8000

# Stripe Test Mode
STRIPE_SECRET_KEY=sk_test_your-stripe-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# Brevo
BREVO_API_KEY=your-brevo-api-key-here
BREVO_SENDER_EMAIL=your-verified-email@example.com
BREVO_SENDER_NAME=ElectroHub

# Commerce email (Task 03.8). Safe defaults: nothing is enqueued, dispatched or sent until deliberately enabled.
# COMMERCE_EMAIL_ENQUEUE_ENABLED=false        # producer: create outbox events with Order/Payment transitions
# COMMERCE_EMAIL_DISPATCH_ENABLED=false       # worker master switch (npm run email:worker)
# COMMERCE_EMAIL_SEND_MODE=disabled           # disabled | capture (disposable DB only) | allowlist | live
# COMMERCE_EMAIL_ALLOWED_RECIPIENTS=          # allowlist mode: comma-separated controlled test mailboxes only
# COMMERCE_EMAIL_LIVE_APPROVED_TARGET=        # live mode on a shared DB: exact host:port/database identity
# COMMERCE_EMAIL_ORIGIN=                      # trusted HTTPS frontend origin for email links (falls back to FRONTEND_URL)
# COMMERCE_EMAIL_CAPTURE_DIR=                 # capture mode output directory
# COMMERCE_EMAIL_BATCH_SIZE=10
# COMMERCE_EMAIL_CONCURRENCY=2
# COMMERCE_EMAIL_POLL_MS=5000
# COMMERCE_EMAIL_PROVIDER_TIMEOUT_MS=10000
# COMMERCE_EMAIL_LEASE_MS=60000

# Cloudinary
CLOUDINARY_URL=cloudinary://key:secret@cloud

# Optional persistent local log directory; default is apps/backend/logs.
# Export in the host environment before launch; bootstrap precedes .env loading.
# ELECTROHUB_LOG_DIR=/var/log/electrohub

# Confirmation-started signal. Set to true ONLY on databases where migration 20261016000000_payment_attempt_confirmation_started is applied.
PAYMENT_CONFIRMATION_SIGNAL=false

# Payment isolation boundary (src/payment-isolation.ts). Payment mutations (recovery workers, Stripe create/capture/cancel/refund,
# webhook ingestion, customer payment writes) run automatically only against a loopback database named electrohub_disposable* or
# electrohub_ci*. Any other (shared) database requires this to equal the exact resolved target "host:port/database" (logged at startup as
# event payment.isolation.resolved), and is never honoured under the watched dev server (`npm run dev`). Set it only on a reviewed deployment.
# PAYMENT_SHARED_MUTATIONS_APPROVED=
