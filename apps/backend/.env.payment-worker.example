# Separate host-side payment-recovery worker contract. Replace placeholders only after operator approval.
# This worker must use the least-privileged backend runtime DB role; migration credentials never belong here.
NODE_ENV=production
PORT=5000
ELECTROHUB_ENV_FILES=none
FRONTEND_URL=https://REPLACE_WITH_APPROVED_FRONTEND_HOSTNAME
DATABASE_URL=postgresql://REPLACE_WITH_RUNTIME_LOGIN:REPLACE_WITH_PASSWORD@REPLACE_WITH_PROD_ENDPOINT:5432/postgres?sslmode=require
DIRECT_URL=postgresql://REPLACE_WITH_RUNTIME_LOGIN:REPLACE_WITH_PASSWORD@REPLACE_WITH_PROD_ENDPOINT:5432/postgres?sslmode=require

# These are worker-local random decoys required by the shared backend environment schema. Generate unique values;
# never reuse customer JWT/refresh or OTP signing secrets.
JWT_SECRET=REPLACE_WITH_WORKER_ONLY_RANDOM_VALUE
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_WORKER_ONLY_RANDOM_VALUE
OTP_HASH_SECRET=REPLACE_WITH_WORKER_ONLY_RANDOM_VALUE
BREVO_API_KEY=UNUSED_NOT_A_CREDENTIAL
BREVO_SENDER_EMAIL=unused@example.invalid

# Stripe Test Mode only; leave unset until the separate operator approval and Test Mode account check.
# STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_TEST_KEY

# No public listener, provider dispatch or admin bootstrap in this worker role.
ADMIN_SEED_PROVISIONING_ENABLED=false
