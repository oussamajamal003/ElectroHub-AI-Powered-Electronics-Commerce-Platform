# Separate host-side email/push worker contract. This worker must use the least-privileged backend runtime DB role.
NODE_ENV=production
PORT=5000
ELECTROHUB_ENV_FILES=none
FRONTEND_URL=https://REPLACE_WITH_APPROVED_FRONTEND_HOSTNAME
COMMERCE_EMAIL_ORIGIN=https://REPLACE_WITH_APPROVED_EMAIL_LINK_ORIGIN
DATABASE_URL=postgresql://REPLACE_WITH_RUNTIME_LOGIN:REPLACE_WITH_PASSWORD@REPLACE_WITH_PROD_ENDPOINT:5432/postgres?sslmode=require
DIRECT_URL=postgresql://REPLACE_WITH_RUNTIME_LOGIN:REPLACE_WITH_PASSWORD@REPLACE_WITH_PROD_ENDPOINT:5432/postgres?sslmode=require

# Public asset URL allowlist for email rendering only. No Storage write credential belongs in this worker.
SUPABASE_URL=https://REPLACE_WITH_VERIFIED_PROD_PROJECT_REF.supabase.co
SUPABASE_PROJECT_REF=REPLACE_WITH_VERIFIED_PROD_PROJECT_REF

# Worker-local random decoys required by the shared backend environment schema; do not reuse API authentication keys.
JWT_SECRET=REPLACE_WITH_WORKER_ONLY_RANDOM_VALUE
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_WORKER_ONLY_RANDOM_VALUE
OTP_HASH_SECRET=REPLACE_WITH_WORKER_ONLY_RANDOM_VALUE

# Keep sends off until recipient target, provider account and operator approval are recorded.
BREVO_API_KEY=REPLACE_WITH_SERVER_SIDE_SECRET
BREVO_SENDER_EMAIL=REPLACE_WITH_VERIFIED_SENDER
BREVO_SENDER_NAME=ElectroHub
COMMERCE_EMAIL_ENQUEUE_ENABLED=false
COMMERCE_EMAIL_DISPATCH_ENABLED=false
COMMERCE_EMAIL_SEND_MODE=disabled
CUSTOMER_PUSH_ENABLED=false
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_VAPID_SUBJECT=
# CUSTOMER_PUSH_APPROVED_TARGET=
ADMIN_SEED_PROVISIONING_ENABLED=false
