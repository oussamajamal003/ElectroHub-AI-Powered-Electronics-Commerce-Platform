# Safe contract only. Copy to the protected host-side backend.env after each value is approved.
# This example is deliberately non-runnable: replace placeholders and pass production validation before startup.
NODE_ENV=production
PORT=5000

# Must be the exact canonical HTTPS origin served by Nginx and used by customer/admin browser sessions.
# Cookie refresh/logout requests require this exact Origin; do not add a path, trailing slash, DEV host,
# localhost or private IP. Keep Google callbacks and customer-facing email links on this same origin.
FRONTEND_URL=https://REPLACE_WITH_APPROVED_FRONTEND_HOSTNAME
# Optional approved public HTTPS origin used by generated email links; keep it equal to FRONTEND_URL.
COMMERCE_EMAIL_ORIGIN=https://REPLACE_WITH_APPROVED_FRONTEND_HOSTNAME

# The API process gets only the approved least-privileged runtime role. Keep DIRECT_URL on that same
# runtime role: this is a required Prisma runtime setting, not the migration credential.
# Migration-only credentials belong to the protected GitHub Environment workflow, never this file.
# Do not copy DEV endpoints. Select the measured direct/session-pooler runtime endpoint after preflight.
DATABASE_URL=postgresql://REPLACE_WITH_RUNTIME_LOGIN:REPLACE_WITH_PASSWORD@REPLACE_WITH_PROD_ENDPOINT:5432/postgres?sslmode=require
DIRECT_URL=postgresql://REPLACE_WITH_RUNTIME_LOGIN:REPLACE_WITH_PASSWORD@REPLACE_WITH_PROD_ENDPOINT:5432/postgres?sslmode=require
# Set only if measurements and reviewed runtime architecture select the DATABASE_URL instead of the existing direct default.
# DB_RUNTIME_URL_SOURCE=database
# Optional CA path when required by the verified Supabase TLS chain.
# DB_SSL_CA_CERT_PATH=/etc/electrohub/supabase-ca.pem

# Product-media integration. Project identity must match the verified PROD database project.
# The current integration accepts the modern Supabase secret key or its legacy service-role JWT fallback.
# Confirm the key's actual Storage privileges with the operator; this template does not prove least privilege.
SUPABASE_URL=https://REPLACE_WITH_VERIFIED_PROD_PROJECT_REF.supabase.co
SUPABASE_PROJECT_REF=REPLACE_WITH_VERIFIED_PROD_PROJECT_REF
# SUPABASE_SECRET_KEY=sb_secret_REPLACE_WITH_PROD_STORAGE_KEY
# SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_LEGACY_SERVICE_ROLE_JWT_ONLY_IF_OPERATOR_APPROVES
PRODUCT_MEDIA_BUCKET=product-media
PRODUCT_MEDIA_STORAGE_TIMEOUT_MS=10000

# Unique production-only random secrets. Replace each placeholder with a distinct cryptographically random value.
# OTP_HASH_SECRET must contain at least 32 UTF-8 bytes (256 bits); the backend and deployment preflight reject placeholders,
# short/predictable/repeated values, and reuse of JWT signing secrets. Do not copy a value from another environment.
JWT_SECRET=REPLACE_WITH_UNIQUE_RANDOM_VALUE
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_UNIQUE_RANDOM_VALUE
OTP_HASH_SECRET=REPLACE_WITH_UNIQUE_RANDOM_VALUE

# Server-side email credentials. No provider dispatch is enabled by these values alone.
BREVO_API_KEY=REPLACE_WITH_SERVER_SIDE_SECRET
BREVO_SENDER_EMAIL=REPLACE_WITH_VERIFIED_SENDER
BREVO_SENDER_NAME=ElectroHub

# Stripe Test Mode only. Hosted webhook secrets are endpoint-specific and both prefixes are not proof of mode.
# Configure only after the exact HTTPS webhook endpoint and Test Mode dashboard state are verified.
# STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_TEST_KEY
# STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_HOSTED_TEST_WEBHOOK_SECRET

# Google OAuth is optional. If enabled, callback origin must equal FRONTEND_URL and path must be /api/auth/google/callback.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# The OAuth web-server callback must use the same canonical HTTPS origin and this exact callback path.
# GOOGLE_REDIRECT_URI=https://REPLACE_WITH_APPROVED_FRONTEND_HOSTNAME/api/auth/google/callback

# Express -> private FastAPI service credential, separate from all customer and provider credentials.
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_API_KEY=REPLACE_WITH_PER_ENVIRONMENT_RANDOM_KEY

# Leave production email/push dispatch disabled until the exact target and operator approval are documented.
COMMERCE_EMAIL_ENQUEUE_ENABLED=false
COMMERCE_EMAIL_DISPATCH_ENABLED=false
COMMERCE_EMAIL_SEND_MODE=disabled
CUSTOMER_PUSH_ENABLED=false
ADMIN_SEED_PROVISIONING_ENABLED=false
# Keep false. Set true only as a one-command override for the explicitly approved interactive first-owner bootstrap.
ADMIN_BOOTSTRAP_ENABLED=false
