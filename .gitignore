# ==========================================
# ElectroHub Monorepo .gitignore
# ==========================================

# --- Dependencies ---
node_modules/
.pnp
.pnp.js

# --- Build Outputs ---
dist/
build/
.next/
out/

# --- Environment Variables ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Any other local variant (e.g. .env.test-customer, .env.staging); only the .env.example templates are tracked.
.env.*
!.env.example

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Testing ---
coverage/
.nyc_output/
test-results/
playwright-report/
screenshots/

# --- TypeScript ---
*.tsbuildinfo

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
*.egg-info/
.eggs/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Docker ---
.docker/

# --- Prisma ---
# Generated Prisma Client is in node_modules and should not be committed

# --- Misc ---
*.tgz
.cache/
.temp/
.tmp/
scratch/
apps/frontend/storybook-static/

# curl cookie jars must never be committed
cookies.txt

# Isolated local payment development (disposable PostgreSQL, generated test credentials)
apps/backend/.isolated/
apps/backend/.isolated-docker/
apps/backend/.ai-vector/
apps/backend/.product-media/
.vitest-tmp/
apps/ai-service/.pytest-tmp-ai/

# Local backend cache (test and tooling artifacts, never committed)
apps/backend/.cache/

# Local agent settings, diagnostics and review patches (not tracked)
.claude/
apps/frontend/diag.txt
docs/tasks/Phase-03/AUTH_REFRESH_LINEAGE_REVIEW.patch
docs/tasks/Phase-03/CI_MIGRATION_SAFETY_REVIEW.patch

# Task 04.2 trained model artifacts (safetensors + descriptor); distributed out of band, mounted read-only.
apps/ai-service/models/
