{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ElectroHub immutable local release bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releaseSha", "createdAt", "repository", "workflow", "workflowRunId", "workflowRunAttempt", "runnerArchitecture", "sourceArchive", "imageArchive", "aiProductionRelease", "aiModelManifest", "images"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "releaseSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "repository": { "type": "string", "minLength": 1 },
    "workflow": { "type": "string", "minLength": 1 },
    "workflowRunId": { "type": ["string", "null"] },
    "workflowRunAttempt": { "type": ["string", "null"] },
    "runnerArchitecture": { "type": ["string", "null"] },
    "sourceArchive": { "$ref": "#/$defs/archive" },
    "imageArchive": { "$ref": "#/$defs/archive" },
    "aiProductionRelease": { "$ref": "#/$defs/archive" },
    "aiModelManifest": { "$ref": "#/$defs/archive" },
    "images": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "reference", "configDigest", "declaredBaseImageTags"],
        "properties": {
          "name": { "enum": ["backend", "ai-service", "edge"] },
          "reference": { "type": "string", "pattern": "^electrohub/(backend|ai-service|edge):[0-9a-f]{40}$" },
          "configDigest": { "$ref": "#/$defs/digest" },
          "declaredBaseImageTags": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256"],
      "properties": {
        "file": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
